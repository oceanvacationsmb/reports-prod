MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ocean-vacations?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
PRIMARY_ADMIN_EMAIL=admin@example.com
APP_URL=https://reports.oceanvacationsmb.com

# Password reset emails
RESEND_API_KEY=
PASSWORD_RESET_FROM="Ocean Vacations <no-reply@oceanvacationsmb.com>"

# Cloudinary invoice uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Guesty Open API (available-night calendar rates)
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
GUESTY_CALENDAR_CACHE_TTL_MINUTES=30

# Optional runtime defaults
DEFAULT_GUESTY_CACHE_TTL_MINUTES=30

# Daily statement cron. Vercel sends this as Authorization: Bearer.
CRON_SECRET=

# Gmail send for approved owner statements. Leave SEND disabled until OAuth is connected.
# See docs/owner-statement-email.md. Do not put a refresh token in env; it is stored after Connect.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://reports.oceanvacationsmb.com/api/gmail/callback
GMAIL_SEND_ENABLED=false
